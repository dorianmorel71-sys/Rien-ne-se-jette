rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque personne ne peut lire et écrire que son propre document.
    match /utilisateurs/{uid} {
      function moi() {
        return request.auth != null && request.auth.uid == uid;
      }

      function donnees() {
        return request.resource.data;
      }

      // Champ modifié par cette écriture (les autres ont déjà été vérifiés avant).
      function change(champ) {
        return resource == null || champ in donnees().diff(resource.data).affectedKeys();
      }

      // Seuls les champs de l'appli, avec leur type et une taille raisonnable.
      function valide() {
        return donnees().keys().hasOnly(['favoris', 'compteur', 'frigo', 'foyer', 'nouvelles', 'avatar'])
          && (!('favoris' in donnees()) || donnees().favoris is map)
          && (!('compteur' in donnees()) || donnees().compteur is map)
          && (!('frigo' in donnees()) || (donnees().frigo is list && donnees().frigo.size() <= 500))
          && (!('foyer' in donnees()) || (donnees().foyer is string && donnees().foyer.size() <= 100))
          && (!change('nouvelles') || !('nouvelles' in donnees())
            || (donnees().nouvelles.keys().hasOnly(['email', 'date'])
              && donnees().nouvelles.date == request.time))
          && (!change('avatar') || !('avatar' in donnees())
            || (donnees().avatar.keys().hasOnly(['emoji', 'couleur', 'photo'])
              && (!('emoji' in donnees().avatar) || donnees().avatar.emoji.size() <= 20)
              && (!('couleur' in donnees().avatar) || donnees().avatar.couleur.size() <= 40)));
      }

      allow read, delete: if moi();
      allow create, update: if moi() && valide();
    }

    // Avis des testeurs : chacun peut en envoyer, personne ne peut les relire depuis l'appli
    // (ils se lisent dans la console Firebase).
    match /avis/{avisId} {
      function texte(champ, max) {
        return !(champ in request.resource.data)
          || (request.resource.data[champ] is string && request.resource.data[champ].size() <= max);
      }

      allow create: if request.resource.data.keys()
          .hasOnly(['texte', 'humeur', 'email', 'page', 'appareil', 'installee', 'uid', 'date'])
        && request.resource.data.texte is string
        && request.resource.data.texte.size() > 0
        && texte('texte', 2000) && texte('email', 300) && texte('page', 300)
        && texte('appareil', 300)
        && (!('humeur' in request.resource.data)
          || request.resource.data.humeur in ['adore', 'bien', 'bof', 'bug'])
        && (!('installee' in request.resource.data) || request.resource.data.installee is bool)
        && (!('uid' in request.resource.data)
          || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && request.resource.data.date == request.time;
    }

    // Frigo partagé : seuls les membres le voient et le modifient.
    match /foyers/{foyerId} {
      function membre() {
        return request.auth != null && request.auth.uid in resource.data.membres;
      }

      allow read: if membre();

      // On crée un foyer dont on est le seul membre.
      allow create: if request.auth != null
        && request.resource.data.membres == [request.auth.uid];

      // Un membre modifie le foyer ; une personne invitée (qui a le lien) ne peut
      // que s'y ajouter elle-même, avec son prénom.
      allow update: if membre()
        || (request.auth != null
          && request.resource.data.membres == resource.data.membres.concat([request.auth.uid])
          && request.resource.data.membres.size() <= 10
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membres', 'noms'])
          && request.resource.data.noms.diff(resource.data.noms).affectedKeys()
            .hasOnly([request.auth.uid]));

      // Le dernier membre qui part supprime le foyer.
      allow delete: if membre() && resource.data.membres.size() == 1;
    }
  }
}
